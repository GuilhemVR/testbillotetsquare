on:
  push:
    branches: ["main"]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: github-pages
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Recuperer les fichiers
        uses: actions/checkout@v4

      - name: Installer Node
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: npm

      - name: Configurer GitHub Pages
        id: pages
        uses: actions/configure-pages@v5

      - name: Installer et construire
        run: |
          npm ci
          npm run build

      - name: Adapter les liens au depot
        env:
          BASE_PATH: ${{ steps.pages.outputs.base_path }}
        run: |
          python3 - <<'PY'
          import os
          import re
          from pathlib import Path

          base = os.environ["BASE_PATH"].rstrip("/")
          for page in Path("dist").rglob("*.html"):
              html = page.read_text()
              html = re.sub(
                  r'(\b(?:href|src|action)=")/(?!/)',
                  lambda m: m.group(1) + base + "/",
                  html,
              )
              page.write_text(html)
          PY

      - name: Preparer la publication
        uses: actions/upload-pages-artifact@v3
        with:
          path: dist

      - name: Publier
        id: deployment
        uses: actions/deploy-pages@v4
